<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <service
            android:name="cl.matiaspalma.everythingimu.core.service.TrackingService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuously streams on-device motion-sensor data and hosts BLE controller connections, forwarding orientation to a paired computer over the local network for full-body motion tracking while the app runs in the background." />
        </service>
    </application>

</manifest>
